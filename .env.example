# ==============================================================================
# Baatkry / Monkey Omegle App - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Supabase Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# LiveKit WebRTC RTC Server Credentials
# Found in: LiveKit Cloud Console -> Project Settings -> Keys
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Application Details
APP_NAME=Baatkry
APP_TAGLINE=Meet new people instantly over live video
